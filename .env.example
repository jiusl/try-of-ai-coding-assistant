# ====================================================
# Try — 环境变量配置模板
# 复制此文件为 .env 并根据需要修改
# ====================================================

# 服务器配置
# TRY_PORT=3456

# 运行模式: 不设置/true=开发模式（跳过 License 签名验证），false/0=正式模式
# TRY_DEV_MODE=true

# 日志级别: debug | info | warn | error
# TRY_LOG_LEVEL=info

# 数据库文件路径
# TRY_DB_PATH=./try.db

# License 文件路径（默认 ./license.json）
# TRY_LICENSE_PATH=./license.json

# 工作目录
# TRY_WORKSPACE=./

# 最大对话轮数
# TRY_MAX_TURNS=50

# ⚠️ 模型配置（Provider / Model / Temperature）请在 try.json 中配置
# ⚠️ API Key / Base URL 请在 auth.json 中配置
# 复制 auth.example.json 为 auth.json 并填入 Key 即可

