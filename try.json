{
  "model": {
    "provider": "deepseek",
    "model": "deepseek-v4-flash",
    "temperature": 0.7,
    "maxTokens": 4096
  },
  "models": [
    {
      "provider": "openai",
      "model": "gpt-4o-mini",
      "temperature": 0.7,
      "maxTokens": 4096
    },
    {
      "provider": "anthropic",
      "model": "claude-sonnet-4-20250514",
      "temperature": 0.7,
      "maxTokens": 4096
    },
    {
      "provider": "deepseek",
      "model": "deepseek-v4-flash",
      "temperature": 0.7,
      "maxTokens": 4096
    }
  ],
  "permissions": {
    "defaultAllow": [
      "read"
    ],
    "rules": [
      {
        "pattern": "**/*",
        "allow": [
          "read",
          "write",
          "edit"
        ],
        "requireConfirm": false,
        "description": "允许读写所有文件（含绝对路径）"
      },
      {
        "pattern": "{npm *,bun *,git *,pnpm *,yarn *,node *,python *,py *,pip *,pip3 *,poetry *,cargo *,go *,rustc *,make *,npx *,tsc *,eslint *,prettier *,deno *,ls *,dir *,cat *,type *,echo *,cd *,mkdir *,copy *,cp *,mv *,ren *,touch *,which *,where *,whoami *,pwd *,printenv *,env *,rm *,rmdir *,chmod *,chown *,curl *,wget *,tar *,zip *,unzip *,gzip *,gunzip *,find *,grep *,sed *,awk *,sort *,uniq *,wc *,head *,tail *,tee *,ping *,traceroute *,nslookup *,ssh *,scp *,rsync *,systeminfo *,tasklist *,taskkill *,netstat *,ipconfig *,set *,export *}",
        "allow": [
          "execute",
          "shell"
        ],
        "requireConfirm": false,
        "description": "允许执行常用开发和 Shell 命令"
      },
      {
        "pattern": "**/.env",
        "allow": [],
        "description": "禁止读写 .env 文件"
      },
      {
        "pattern": "**/.git/**",
        "allow": [],
        "description": "禁止访问 .git 目录"
      }
    ]
  },
  "systemPrompt": "你是一个智能编程助手。",
  "maxConversationTurns": 50,
  "workspaceRoot": "."
}