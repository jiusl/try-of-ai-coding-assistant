{
  "model": {
    "provider": "deepseek",
    "model": "deepseek-chat",
    "temperature": 0.7,
    "maxTokens": 4096
  },
  "models": [
    { "provider": "openai", "model": "gpt-4o-mini", "temperature": 0.7, "maxTokens": 4096 },
    { "provider": "anthropic", "model": "claude-sonnet-4-20250514", "temperature": 0.7, "maxTokens": 4096 },
    { "provider": "deepseek", "model": "deepseek-v4-flash", "temperature": 0.7, "maxTokens": 4096 }
  ],
  "permissions": {
    "defaultAllow": ["read"],
    "rules": [
      { "pattern": "**/*.md", "allow": ["read", "write"], "requireConfirm": false, "description": "允许读写 Markdown 文件" },
      { "pattern": "**/*.json", "allow": ["read"], "requireConfirm": false, "description": "允许读取 JSON 文件" },
      { "pattern": "**/.env", "allow": [], "description": "禁止读取环境变量文件" },
      { "pattern": "**/*", "allow": ["read", "glob"], "requireConfirm": false, "description": "允许搜索和读取所有文件" }
    ]
  },
  "systemPrompt": "你是一个智能编程助手。",
  "maxConversationTurns": 50,
  "workspaceRoot": "."
}
