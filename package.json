{
  "name": "try",
  "version": "0.1.0",
  "description": "AI-powered coding assistant",
  "type": "module",
  "bin": {
    "try": "./src/bin/try.ts"
  },
  "scripts": {
    "start": "bun run src/bin/try.ts",
    "dev": "bun --watch run src/bin/try.ts",
    "web": "bun run src/bin/try.ts web",
    "dev:web": "bun run --cwd src/web dev",
    "build:web": "bun run --cwd src/web build",
    "build": "bun run scripts/build-backend.ts",
    "build:compile": "bun run scripts/build-backend.ts --compile",
    "gen-keys": "bun -e \"const {generateKeyPairSync}=await import('crypto');const {publicKey,privateKey}=generateKeyPairSync('rsa',{modulusLength:2048,publicKeyEncoding:{type:'spki',format:'pem'},privateKeyEncoding:{type:'pkcs8',format:'pem'}});await Bun.write('license_public.pem',publicKey);await Bun.write('license_private.pem',privateKey);console.log('Keys generated')\"",
    "sign-license": "bun run scripts/sign-license.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@chakra-ui/react": "^3.0.0",
    "@emotion/react": "^11.14.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "chalk": "^5.6.2",
    "commander": "^15.0.0",
    "effect": "^3.21.2",
    "marked": "^18.0.5",
    "micromatch": "^4.0.8",
    "openai": "^6.42.0",
    "pdfjs-dist": "^4.0.379",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "remeda": "^2.37.0",
    "typescript": "^6.0.3"
  },
  "optionalDependencies": {
    "node-llama-cpp": "^3.18.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/micromatch": "^4.0.10",
    "@types/node": "^25.9.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "vite": "^6.0.0"
  }
}
