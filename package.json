{
  "name": "try",
  "version": "0.1.0",
  "description": "AI-powered coding assistant",
  "type": "module",
  "bin": {
    "try": "./src/bin/try.ts"
  },
  "scripts": {
    "start": "bun run src/bin/try.ts",
    "dev": "bun --watch run src/bin/try.ts",
    "web": "bun run src/bin/try.ts web",
    "build": "bun build src/bin/try.ts --outdir dist --target bun",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "chalk": "^5.6.2",
    "commander": "^15.0.0",
    "effect": "^3.21.2",
    "micromatch": "^4.0.8",
    "openai": "^6.42.0",
    "pdfjs-dist": "^4.0.379",
    "remeda": "^2.37.0",
    "typescript": "^6.0.3"
  },
  "optionalDependencies": {
    "node-llama-cpp": "^3.18.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/micromatch": "^4.0.10",
    "@types/node": "^25.9.1"
  }
}
