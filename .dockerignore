# 依赖
node_modules/

# 版本控制
.git/
.gitignore

# 运行时数据（通过 volume 挂载）
*.db
*.db-wal
*.db-shm
data/

# 模型文件（体积大，通过 volume 单独挂载）
model/*.gguf

# 构建产物（在容器内重新构建）
dist/

# 测试
test/
src/test/

# 日志
*.log
logs/

# 环境变量（通过 docker-compose 注入）
.env
.env.local

# 重要：私钥绝不进镜像
license_private.pem

# License 文件（通过 volume 挂载或默认免费版）
# license.json 不排除，如果有默认的免费版 license 会包含进去

# 认证密钥（通过 volume 挂载）
auth.json

# IDE
.vscode/
.idea/

# 文档
README.md
